{
  "name": "@aigc/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:smoke": "vitest run --config db/postgres-smoke.vitest.config.ts",
    "metadata-audit:asset-attachments": "tsx db/asset-attachment-metadata-audit.ts",
    "storage-backfill:asset-attachments": "tsx db/asset-attachment-storage-backfill.ts",
    "test:asset-attachment-object-storage": "vitest run --config asset-attachment-object-storage.integration.vitest.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aigc/domain": "0.1.0",
    "@aws-sdk/client-s3": "^3.1057.0",
    "drizzle-orm": "^0.45.0",
    "lucide-react": "^0.555.0",
    "next": "^16.0.3",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
